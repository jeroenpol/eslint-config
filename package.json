{
  "name": "@jeroenpol/eslint-config",
  "version": "3.1.0",
  "description": "ESLint config made for Angular, configured by Polware",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./typescript": "./configurations/best-practices-ts.mjs",
    "./angular": "./configurations/best-practices-html.mjs",
    "./stylistic": "./configurations/code-style.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "configurations",
    "custom-rules"
  ],
  "scripts": {
    "lint": "eslint",
    "test": "node --test test/config.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeroenpol/eslint-config"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "javascript",
    "typescript",
    "angular",
    "styleguide",
    "polware"
  ],
  "author": "Jeroen Pol (https://www.linkedin.com/in/jeroenpol)",
  "contributors": [
    {
      "name": "Jeroen Pol",
      "url": "https://www.linkedin.com/in/jeroenpol"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeroenpol/eslint-config/issues"
  },
  "homepage": "https://github.com/jeroenpol/eslint-config",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "angular-eslint": "^22.6.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.8.0 <6.1.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
